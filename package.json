{
  "name": "formblatt",
  "version": "2.0.0",
  "description": "A 100% private, client-side visual PDF form builder and ISO 32000 AcroForm generator that runs entirely in your browser.",
  "type": "module",
  "main": "js/main.js",
  "scripts": {
    "test": "node test/run-unit-tests.js && node tests/test_suite.js",
    "test:unit": "node test/run-unit-tests.js",
    "test:detector": "node tests/evaluate_detector_cli.js",
    "test:commonforms": "node tests/evaluate_commonforms.js",
    "bench": "node tests/benchmark_speed.js",
    "start": "node server.cjs",
    "start:sidecar": ".venv/bin/uvicorn server:app --port 8000"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sshrestha-design/formblatt.git"
  },
  "homepage": "https://formblatt.dpdns.org",
  "keywords": [
    "pdf",
    "acroform",
    "form-builder",
    "pdf-form-builder",
    "client-side",
    "privacy-first",
    "open-source"
  ],
  "author": "Sagar Shrestha",
  "license": "MIT",
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0"
  }
}
